rules_version = '2';

// Reglas de RODO ₿ Games
// - Cualquiera puede leer partidas y rankings.
// - Para crear partidas o guardar resultados hay que estar autenticado (anónimo alcanza).
// - Las partidas y los resultados no se pueden modificar ni borrar desde la web.
// - Cada persona guarda un solo resultado por partida: el primero.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Administración: solo esta cuenta de Google (verificada) puede leer las fichas de todos
    // Administración: estas cuentas de Google (verificadas)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') in ['claudia@rodo.es', 'ce.andragnes@gmail.com']
        && request.auth.token.get('email_verified', false) == true;
    }
    function validKey(k) {
      return k.matches('^(acrostico|ahorcado|ahorcado6|sopa|sopachica|sopagrande|criptograma|anagrama|semilla|esbip|placa)-(es|en)$');
    }

    // Contador por juego e idioma: solo sube de a uno, junto con la partida nueva
    match /counters/{key} {
      allow read: if true;
      allow create: if signedIn() && validKey(key)
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1
        && existsAfter(/databases/$(database)/documents/puzzles/$(key + '-1'));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && existsAfter(/databases/$(database)/documents/puzzles/$(key + '-' + string(request.resource.data.count)));
      allow delete: if false;
    }

    // Partidas numeradas: se crean una vez y quedan fijas
    match /puzzles/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['game', 'lang', 'n', 'data', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.n is int
        && validKey(request.resource.data.game + '-' + request.resource.data.lang)
        && id == request.resource.data.game + '-' + request.resource.data.lang + '-' + string(request.resource.data.n)
        && getAfter(/databases/$(database)/documents/counters/$(request.resource.data.game + '-' + request.resource.data.lang)).data.count == request.resource.data.n;
      allow update, delete: if false;
    }

    // Resultados: un documento por jugador y partida, solo el propio y solo una vez
    match /scores/{id}/players/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/puzzles/$(id))
        && request.resource.data.keys().hasOnly(['g', 'ok', 's', 'h', 'e', 'c', 'm', 'b', 'ms', 'at'])
        // e: errores; c: veces que tocó "Comprobar"; m: modo de la sopa (w palabras, c pistas). Los resultados viejos no los tienen
        && (!('e' in request.resource.data) || (request.resource.data.e is int && request.resource.data.e >= 0))
        && (!('c' in request.resource.data) || (request.resource.data.c is int && request.resource.data.c >= 0))
        && (!('m' in request.resource.data) || request.resource.data.m in ['w', 'c'])
        // b: palabras extra encontradas en la sopa (cada una descuenta 30 s; hasta 5)
        && (!('b' in request.resource.data) || (request.resource.data.b is int && request.resource.data.b >= 1 && request.resource.data.b <= 5))
        && request.resource.data.g == id.split('-')[0]
        && request.resource.data.ok is bool
        && request.resource.data.s is int && request.resource.data.s >= 0 && request.resource.data.s <= 20
        && request.resource.data.h is int && request.resource.data.h >= 0
        && request.resource.data.ms is int && request.resource.data.ms >= 1000
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Lectura de todos los resultados de un juego (ranking general)
    match /{path=**}/players/{uid} {
      allow read: if true;
    }

    // Ficha de cada jugador (navegador): primera y última visita, partidas vistas y jugadas.
    // Solo la lee y la escribe su dueño.
    // (no se llama "players" para no mezclarse con los resultados, que se leen como grupo "players")
    // Diccionarios: cambios al glosario hechos desde el panel (id = idioma-número). Los lee el sitio; los escribe solo la administración.
    // w: palabra, c: hasta 3 pistas, d: definición, off: oculta en los juegos, tr: pendiente de traducir (réplica del otro idioma), src: de qué entrada salió
    match /dict/{id} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['L', 'n', 'w', 'c', 'd', 'off', 'tr', 'src', 'at', 'k'])
        && (!('k' in request.resource.data) || (request.resource.data.k is list && request.resource.data.k.size() <= 12))
        && request.resource.data.L in ['es', 'en'] && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 5000
        && id == request.resource.data.L + '-' + string(request.resource.data.n)
        && (!('w' in request.resource.data) || (request.resource.data.w is string && request.resource.data.w.size() <= 30))
        && (!('c' in request.resource.data) || (request.resource.data.c is list && request.resource.data.c.size() <= 3))
        && (!('d' in request.resource.data) || (request.resource.data.d is string && request.resource.data.d.size() <= 1200));
      allow delete: if isAdmin();
    }
    match /fichas/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['first', 'last', 'seen', 'plays', 'inv', 'cl', 'vis', 'vd'])
        // vis: cuántas veces entró (una por pestaña) y vd: entradas por día ({"2026-10-25": 3}), para el perfil del panel
        && (!('vis' in request.resource.data) || request.resource.data.vis is int)
        && (!('vd' in request.resource.data) || request.resource.data.vd is map)
        // cl: códigos de las pistas que ya vio, por idioma ({es: ["2.3", ...]})
        && (!('cl' in request.resource.data) || request.resource.data.cl is map)
        // inv: cuántas invitaciones a jugar mandó
        && (!('inv' in request.resource.data) || request.resource.data.inv is int)
        && request.resource.data.seen is map
        && request.resource.data.plays is map;
      allow delete: if false;
    }

    // Apodos para el ranking: cada uno edita el suyo, y tiene que tenerlo reservado en nicks (son únicos)
    function validNick(n) {
      return n is string && n.size() > 0 && n.size() <= 24
        && n.matches('^[^/\\s]([^/]*[^/\\s])?$') && !n.matches('^[.]+$') && !n.matches('^__.*__$');
    }
    match /names/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'av', 'at'])
        && validNick(request.resource.data.name)
        // at: cuándo armó su usuario (la hora del servidor la primera vez; después no cambia)
        && (!('at' in request.resource.data) || request.resource.data.at == request.time
            || (resource != null && request.resource.data.at == resource.data.get('at', null)))
        // av: el avatar (un emoji)
        && (!('av' in request.resource.data) || (request.resource.data.av is string && request.resource.data.av.size() <= 8))
        && getAfter(/databases/$(database)/documents/nicks/$(request.resource.data.name.lower())).data.uid == uid;
    }
    // Reserva de apodos: la clave es el apodo en minúsculas y guarda de quién es.
    // Se crea junto con el apodo propio y se libera al cambiarlo; no se puede pisar la de otro.
    match /nicks/{key} {
      allow read: if true;
      // v: versión del PIN (se cambia cada vez que el dueño pone un PIN; arma el mail interno de la cuenta)
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'v'])
        && request.resource.data.uid == request.auth.uid
        && (!('v' in request.resource.data) || (request.resource.data.v is string && request.resource.data.v.size() <= 16))
        && getAfter(/databases/$(database)/documents/names/$(request.auth.uid)).data.name.lower() == key;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'v'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.v is string && request.resource.data.v.size() <= 16
        && getAfter(/databases/$(database)/documents/names/$(request.auth.uid)).data.name.lower() == key;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/names/$(request.auth.uid)).data.name.lower() != key)
        || isAdmin();
    }

    // "¿Aprendiste alguna palabra nueva?": una respuesta por jugador y partida, que puede cambiar.
    match /learned/{id} {
      // la administración ve todas; cada jugador, las suyas (para sus estadísticas)
      allow read: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['u', 'p', 'g', 'yes', 'duel', 'at', 'n', 'w'])
        && request.resource.data.u == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.p
        && request.resource.data.p is string && request.resource.data.p.size() <= 80
        && request.resource.data.g is string && request.resource.data.g.size() <= 20
        && request.resource.data.yes is bool && request.resource.data.duel is bool
        // n: cuántos conceptos nuevos (las palabras que le faltaron al rendirse)
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 40))
        // w: los números de glosario de las palabras que marcó como aprendidas
        && (!('w' in request.resource.data) || (request.resource.data.w is list && request.resource.data.w.size() <= 40))
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/puzzles/$(request.resource.data.p));
      allow delete: if false;
    }

    // Intentos de PIN por usuario (la clave es el apodo en minúsculas). Cualquiera puede sumar un intento fallido;
    // al tercero sube el nivel: 1 = bloqueado 24 h, 2 = bloqueado 48 h, 3 = bloqueado hasta que lo destrabe la administración.
    // "at" es cuándo empezó el último bloqueo (lo pone el servidor). El dueño, al entrar bien, lo vuelve a cero.
    function pinLocked(o) {
      return o.level >= 3
        || (o.level >= 1 && o.fails == 0 && o.at != null && request.time < o.at + duration.value(o.level == 1 ? 24 : 48, 'h'));
    }
    function pinFail(o) {
      let d = request.resource.data;
      return d.keys().hasOnly(['fails', 'level', 'at']) && d.keys().hasAll(['fails', 'level', 'at']) && !pinLocked(o)
        && ((o.fails < 2 && d.fails == o.fails + 1 && d.level == o.level && d.at == o.at)
          || (o.fails >= 2 && d.fails == 0 && d.level == o.level + 1 && d.at == request.time));
    }
    function pinReset(key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['fails', 'level', 'at']) && d.fails == 0 && d.level == 0 && d.at == null
        && get(/databases/$(database)/documents/nicks/$(key)).data.uid == request.auth.uid;
    }
    // Errores al guardar (p. ej. crear usuario): solo se anotan; los lee la administración para diagnosticar.
    match /errs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['u', 'w', 'c', 'n', 'ua', 'at'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.w is string && request.resource.data.w.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 80
        && (!('n' in request.resource.data) || (request.resource.data.n is string && request.resource.data.n.size() <= 30))
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /pinlocks/{key} {
      allow read: if true;
      allow create: if signedIn() && exists(/databases/$(database)/documents/nicks/$(key))
        && (pinFail({'fails': 0, 'level': 0, 'at': null}) || pinReset(key));
      allow update: if signedIn() && (pinFail(resource.data) || pinReset(key) || isAdmin());
      allow delete: if isAdmin();
    }

    // Uso general de cada pista (un campo por pista, "c2_3"), para elegir las menos vistas.
    // Solo se suman de a pocas pistas por vez; no se borra.
    match /clueuse/{L} {
      allow read: if true;
      allow create: if signedIn() && L in ['es', 'en'] && request.resource.data.keys().size() <= 40;
      allow update: if signedIn() && L in ['es', 'en']
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 40
        && request.resource.data.diff(resource.data).removedKeys().size() == 0;
      allow delete: if false;
    }

    // Navegadores de prueba (los marca la administración): sus resultados no cuentan en rankings ni estadísticas
    match /testers/{uid} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Conectados: cada navegador avisa "estoy acá" cada minuto mientras la pestaña está a la vista.
    // inv: acepta invitaciones ahora; busy: juegos con una partida en curso (no se lo invita a esos)
    match /online/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'lang', 'inv', 'busy', 'nm', 'av'])
        // nm y av: nombre y avatar, para buscar por nombre a quién invitar; tienen que ser los registrados
        && (!('nm' in request.resource.data) || request.resource.data.nm == get(/databases/$(database)/documents/names/$(uid)).data.name)
        && (!('av' in request.resource.data) || request.resource.data.av == get(/databases/$(database)/documents/names/$(uid)).data.get('av', ''))
        && request.resource.data.at == request.time
        && request.resource.data.lang in ['es', 'en']
        && request.resource.data.inv is bool
        && request.resource.data.busy is list && request.resource.data.busy.size() <= 8;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Invitaciones: el documento lleva el uid de quien invita, así cada uno tiene una sola a la vez.
    // Vencen a los 60 segundos (65 de margen). Solo las leen quien invita y quien es invitado.
    function newInvite(from) {
      let d = request.resource.data;
      return d.keys().hasOnly(['to', 'name', 'g', 'k', 'lang', 'n', 'at', 'st', 'd', 'm', 'w', 'r', 'lk', 'sa'])
        // sa: invitación a la sala de quien invita (quien acepta se suma a salas/{from})
        && (!('sa' in d) || d.sa is bool)
        // r: invitación al azar (quien ya rechazó una al azar en su sesión la rechaza sola)
        && (!('r' in d) || d.r is bool)
        // m: modo de la sopa y w: palabras de la semilla, que eligió quien invita
        && (!('m' in d) || d.m in ['w', 'c'])
        && (!('w' in d) || d.w in [12, 24])
        // d: el duelo, cuando es una revancha
        && (!('d' in d) || (d.d is string && d.d.size() <= 300))
        && d.to is string && d.to != from && d.to.size() > 0 && d.to.size() <= 128
        && d.g in ['acrostico', 'ahorcado', 'sopa', 'criptograma', 'anagrama', 'semilla', 'esbip', 'placa']
        && d.k is string && d.lang is string && validKey(d.k + '-' + d.lang)
        && d.n is int
        && d.at == request.time
        && d.st == 'pending'
        // lk: viene de un link compartido (quien lo abrió invita a quien lo mandó)
        && (!('lk' in d) || d.lk == true)
        // el apodo es obligatorio y tiene que ser el que tiene guardado; solo una invitación desde un link puede ir sin apodo
        && ((('lk' in d) && !('name' in d)) || d.name == get(/databases/$(database)/documents/names/$(from)).data.name)
        // la partida es nueva y la creó quien invita
        && get(/databases/$(database)/documents/puzzles/$(d.k + '-' + d.lang + '-' + string(d.n))).data.by == from;
    }
    function onlySt() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']);
    }
    function live() { return request.time < resource.data.at + duration.value(65, 's'); }
    match /invites/{from} {
      allow read: if signedIn() && (request.auth.uid == from || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == from && newInvite(from);
      allow update: if signedIn() && (
        // invitar de nuevo: solo si la anterior ya se respondió o venció
        (request.auth.uid == from && (resource.data.st != 'pending' || !live()) && newInvite(from))
        // quien invita la cancela o la da por vencida
        || (request.auth.uid == from && onlySt() && resource.data.st == 'pending'
            && request.resource.data.st in ['cancelled', 'expired'])
        // quien es invitado responde, dentro del plazo
        // (al aceptar marca go = hora del servidor: los dos arrancan el duelo 5 s después, a la vez)
        || (request.auth.uid == resource.data.to && resource.data.st == 'pending' && live()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'go'])
            && request.resource.data.st in ['accepted', 'declined', 'busy']
            && (!('go' in request.resource.data) || (request.resource.data.st == 'accepted' && request.resource.data.go == request.time))));
      allow delete: if false;
    }

    // Salas: varias personas juegan a la vez la misma partida (nacen del link para compartir; esperan 5 minutos).
    // id = uid de quien la armó. p: quiénes están ({uid: {nm, av}}); go: arranque (hora del servidor), null mientras se espera.
    // games: las partidas de cada ronda (la actual es la última). Las rondas nuevas las abre solo quien armó la sala.
    function salaMe(e) {
      return e is map && e.keys().hasOnly(['nm', 'av'])
        && e.nm == (exists(/databases/$(database)/documents/names/$(request.auth.uid)) ? get(/databases/$(database)/documents/names/$(request.auth.uid)).data.name : '')
        && e.av is string && e.av.size() <= 8;
    }
    function salaOpen(h) {
      let d = request.resource.data;
      return d.keys().hasOnly(['h', 'g', 'k', 'lang', 'n', 'm', 'w', 'games', 'p', 'at', 'go', 'cl'])
        && d.h == h && d.at == request.time && d.go == null && d.get('cl', false) == false
        && d.g is string && d.g.size() <= 20 && d.n is int
        && d.p is map && d.p.keys().hasOnly([h]) && d.p.size() == 1 && salaMe(d.p[h])
        && d.games is list && d.games.size() >= 1 && d.games.size() <= 60
        && d.games[d.games.size() - 1] == d.k + '-' + d.lang + '-' + string(d.n)
        && exists(/databases/$(database)/documents/puzzles/$(d.games[d.games.size() - 1]));
    }
    match /salas/{h} {
      allow read: if signedIn();
      // abrir la sala o una ronda nueva: solo quien la arma, sola/o adentro
      allow create, update: if signedIn() && request.auth.uid == h && salaOpen(h);
      // cerrarla (cl): solo quien la armó; después nadie más entra
      allow update: if signedIn() && request.auth.uid == h
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cl'])
        && request.resource.data.cl == true;
      // sumarse o salir: cada uno solo a sí mismo, antes del arranque y dentro de los 5 minutos de espera (más un margen), si no está cerrada
      allow update: if signedIn() && resource.data.go == null && resource.data.get('cl', false) == false
        && request.time < resource.data.at + duration.value(330, 's')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p'])
        && request.resource.data.p.diff(resource.data.p).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.p.size() <= 30
        && (!(request.auth.uid in request.resource.data.p) || salaMe(request.resource.data.p[request.auth.uid]));
      // arrancar: quien la armó, cuando quiera; cualquiera de adentro, pasados los 5 minutos (por si quien la armó se fue)
      allow update: if signedIn() && resource.data.go == null && resource.data.get('cl', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['go'])
        && request.resource.data.go == request.time
        && (request.auth.uid == h || (request.auth.uid in resource.data.p && request.time > resource.data.at + duration.value(300, 's')));
      allow delete: if false;
    }

    // Duelos: la serie de partidas entre dos personas que empezó con una invitación aceptada.
    // id = uid de quien invitó + '_' + primera partida. games: partidas jugadas; last: quién eligió la última.
    // Los resultados no se guardan acá: se calculan con los de cada partida, que no se pueden tocar.
    // Palabras sugeridas para el glosario: cualquiera con sesión sugiere una (w: la palabra en mayúsculas, L: idioma, d: qué significa, opcional);
    // solo la administración las lee, les cambia el estado (st) y les guarda el análisis de Claude (ai), o las borra
    match /sugs/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['w', 'L', 'd', 'u', 'at'])
        && request.resource.data.keys().hasAll(['w', 'L', 'u', 'at'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.w is string && request.resource.data.w.matches('^[A-ZÑ ]{3,30}$')
        && request.resource.data.L in ['es', 'en']
        && (!('d' in request.resource.data) || (request.resource.data.d is string && request.resource.data.d.size() <= 500));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ai'])
        && request.resource.data.get('st', 'nueva') in ['nueva', 'aprobada', 'descartada']
        && request.resource.data.get('ai', {}) is map;
    }

    // Pedidos de rompecabezas (games.rodo.es/rompecabezas): cualquiera autenticado crea uno; solo la administración los lee y les cambia el estado
    function orderQty(m, k) { return !(k in m) || (m[k] is int && m[k] >= 1 && m[k] <= 10); }
    function trimmed(s, lo, hi) { return s is string && s.size() >= lo && s.size() <= hi; }
    // Código de descuento: si el pedido trae uno, tiene que estar vigente y valer para algún rompecabezas del pedido y su medio de pago,
    // y en la misma escritura su contador de usos sube de a uno apuntando a este pedido. El monto lo revisa la administración.
    function orderCoupon(code, o) {
      return !('cup' in o) ? (!('disc' in o) || o.disc == 0)
        : (o.cup is string && o.cup.matches('^[A-Z0-9]{3,20}$')
          && o.disc is int && o.disc >= 1
          && o.sub is int && o.disc <= o.sub && o.total == o.sub - o.disc
          && couponOk(get(/databases/$(database)/documents/coupons/$(o.cup)).data, o)
          && getAfter(/databases/$(database)/documents/coupons/$(o.cup)).data.used == get(/databases/$(database)/documents/coupons/$(o.cup)).data.used + 1
          && getAfter(/databases/$(database)/documents/coupons/$(o.cup)).data.last == code);
    }
    function couponOk(c, o) {
      return c.on == true
        && (c.max == 0 || c.used < c.max)
        && (c.from == 0 || request.time.toMillis() >= c.from)
        && (c.until == 0 || request.time.toMillis() < c.until)
        && o.pay in c.pays
        && o.items.keys().hasAny(c.prods)
        && (c.type != 'fix' || o.disc <= c.value);
    }
    // Códigos de descuento: los crea y edita la administración. Cualquiera puede consultar uno por su código exacto (no listarlos).
    // Al encargar, el contador de usos sube de a uno junto con el pedido nuevo que lo usa.
    match /coupons/{c} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() && c.matches('^[A-Z0-9]{3,20}$')
        && request.resource.data.keys().hasOnly(['type', 'value', 'max', 'used', 'from', 'until', 'prods', 'pays', 'on', 'note', 'last', 'at'])
        && request.resource.data.used == 0 && couponShape(request.resource.data);
      allow update: if (isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'value', 'max', 'used', 'from', 'until', 'prods', 'pays', 'on', 'note', 'last', 'at'])
          && request.resource.data.used == resource.data.used && couponShape(request.resource.data))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'last'])
          && request.resource.data.used == resource.data.used + 1
          && request.resource.data.last is string
          && !exists(/databases/$(database)/documents/orders/$(request.resource.data.last))
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.last)).data.cup == c);
      allow delete: if isAdmin();
    }
    function couponShape(d) {
      return d.type in ['pct', 'fix'] && d.value is int
        && (d.type == 'fix' ? d.value >= 1 && d.value <= 100000000 : d.value >= 1 && d.value <= 100)
        && d.max is int && d.max >= 0 && d.used is int
        && d.from is int && d.until is int && d.from >= 0 && d.until >= 0
        && d.prods is list && d.prods.size() >= 1 && d.prods.toSet().hasOnly(['bip39', 'whitepaper', 'times'])
        && d.pays is list && d.pays.size() >= 1 && d.pays.toSet().hasOnly(['btc', 'ars'])
        && d.on is bool;
    }
    // Pago on-chain: cada pedido en bitcoin toma la siguiente dirección libre (payaddr/{n}, que genera la administración desde su xpub);
    // en la misma escritura el contador btcidx/main sube de a uno apuntando a este pedido, así dos pedidos nunca comparten dirección.
    function orderAddr(code, o) {
      return !('ai' in o) ? !('addr' in o) && !('sats' in o) && !('rate' in o)
        : (o.pay == 'btc' && o.ai is int
          && get(/databases/$(database)/documents/btcidx/main).data.n == o.ai
          && getAfter(/databases/$(database)/documents/btcidx/main).data.n == o.ai + 1
          && getAfter(/databases/$(database)/documents/btcidx/main).data.last == code
          && o.addr == get(/databases/$(database)/documents/payaddr/$(string(o.ai))).data.a
          && o.sats is int && o.sats >= 0 && o.sats <= 2100000000000000
          && o.rate is number && o.rate >= 0);
    }
    // Configuración del cobro on-chain (la clave pública extendida): solo la administración
    match /btcpay/{d} { allow read, write: if isAdmin(); }
    // Direcciones de cobro: las escribe la administración; cualquiera con sesión lee una por su número (no listarlas)
    match /payaddr/{n} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }
    // Próxima dirección libre: la administración la crea/ajusta; un pedido nuevo la sube de a uno
    match /btcidx/{d} {
      allow get: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn() && d == 'main'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'last'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.last is string
        && !exists(/databases/$(database)/documents/orders/$(request.resource.data.last))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.last)).data.ai == resource.data.n;
    }
    match /orders/{code} {
      allow create: if signedIn()
        && code.matches('^R[2-9A-HJ-NP-Z]{6}$')
        && request.resource.data.keys().hasOnly(['items', 'name', 'email', 'phone', 'place', 'ship', 'pay', 'note', 'total', 'lang', 'u', 'st', 'at', 'sub', 'cup', 'disc', 'ai', 'addr', 'sats', 'rate'])
        && request.resource.data.keys().hasAll(['items', 'name', 'email', 'phone', 'place', 'ship', 'pay', 'total', 'lang', 'u', 'st', 'at'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.st == 'nuevo'
        && request.resource.data.items is map
        && request.resource.data.items.keys().hasOnly(['bip39', 'whitepaper', 'times'])
        && request.resource.data.items.size() >= 1
        && orderQty(request.resource.data.items, 'bip39') && orderQty(request.resource.data.items, 'whitepaper') && orderQty(request.resource.data.items, 'times')
        && trimmed(request.resource.data.name, 2, 80)
        && trimmed(request.resource.data.email, 5, 120) && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && trimmed(request.resource.data.phone, 6, 40)
        && trimmed(request.resource.data.place, 2, 120)
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 1000
        && request.resource.data.ship in ['correo', 'dot', 'labitconf']
        && request.resource.data.pay in ['btc', 'ars']
        && request.resource.data.lang in ['es', 'en']
        && request.resource.data.total is int && request.resource.data.total >= 0
        && orderCoupon(code, request.resource.data)
        && orderAddr(code, request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
        && request.resource.data.st in ['nuevo', 'confirmado', 'pagado', 'enviado', 'entregado', 'cancelado'];
      allow delete: if false;
    }

    function invPid(inv) { return inv.k + '-' + inv.lang + '-' + string(inv.n); }
    match /duels/{id} {
      allow read: if signedIn() && (request.auth.uid in resource.data.p || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['p', 'games', 'last', 'at'])
        && request.resource.data.p is list && request.resource.data.p.size() == 2
        && request.resource.data.p[0] == request.auth.uid
        && request.resource.data.games is list && request.resource.data.games.size() == 1
        && request.resource.data.last == request.auth.uid
        && request.resource.data.at == request.time
        && id == request.auth.uid + '_' + request.resource.data.games[0]
        // nace de una invitación propia que la otra persona aceptó, con esa misma partida
        && get(/databases/$(database)/documents/invites/$(request.auth.uid)).data.st == 'accepted'
        && get(/databases/$(database)/documents/invites/$(request.auth.uid)).data.to == request.resource.data.p[1]
        && invPid(get(/databases/$(database)/documents/invites/$(request.auth.uid)).data) == request.resource.data.games[0];
      // revancha: la elige quien no eligió la anterior, y se suma una partida al final
      allow update: if signedIn() && request.auth.uid in resource.data.p
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'last'])
        && request.resource.data.last == request.auth.uid && resource.data.last != request.auth.uid
        && request.resource.data.games.size() == resource.data.games.size() + 1
        && request.resource.data.games.size() <= 60
        && request.resource.data.games[0:resource.data.games.size()] == resource.data.games
        && get(/databases/$(database)/documents/invites/$(request.auth.uid)).data.st == 'accepted'
        && get(/databases/$(database)/documents/invites/$(request.auth.uid)).data.get('d', '') == id
        && get(/databases/$(database)/documents/invites/$(request.auth.uid)).data.to in resource.data.p
        && invPid(get(/databases/$(database)/documents/invites/$(request.auth.uid)).data) == request.resource.data.games[resource.data.games.size()];
      allow delete: if false;
    }

    // ================= Torneos en vivo =================
    // tourneys/{tid}: la configuración y el estado. Lo crea la administración; lo manejan ella y los organizadores (orgs).
    // st: draft (borrador) → open (inscripción) → checkin (confirmar presencia) → live (rondas) → done.
    // pub: desde cuándo se ve en la web (antes no se puede inscribir nadie).
    // Ensayo (test): copia de un torneo (src) para probarlo; no lo ve el público, solo los invitados (inv, uids),
    // y puede tener jugadores falsos (ins y res con id "bot-N") que maneja el panel del organizador.
    function isOrg(tid) {
      return isAdmin() || (request.auth != null && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in get(/databases/$(database)/documents/tourneys/$(tid)).data.get('orgs', []));
    }
    function tour(tid) { return get(/databases/$(database)/documents/tourneys/$(tid)).data; }
    function isTest(tid) { return tour(tid).get('test', false) == true; }
    function validTour(d) {
      // nck y nlv: marcas de la Cloud Function de avisos (check-in y arranque ya avisados)
      return d.keys().hasOnly(['name', 'st', 'cap', 'fee', 'lnurl', 'when', 'pub', 'orgs', 'bases', 'lang', 'cur', 'rounds', 'champ', 'pool', 'at', 'auto', 'nck', 'nlv', 'test', 'src', 'inv', 'place'])
        // place: dónde se juega (texto libre que se muestra en la portada y en la sala)
        && (!('place' in d) || (d.place is string && d.place.size() <= 120))
        && (!('test' in d) || d.test is bool)
        && (!('inv' in d) || (d.inv is list && d.inv.size() <= 40))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.st in ['draft', 'open', 'checkin', 'live', 'done']
        && d.cap is int && d.cap >= 2 && d.cap <= 64
        && d.orgs is list && d.orgs.size() <= 10
        && d.rounds is list && d.rounds.size() <= 8;
    }
    match /tourneys/{tid} {
      allow read: if true;
      allow create: if validTour(request.resource.data) && (isAdmin()
        // un ensayo lo puede armar cualquier organizador del torneo original, con los mismos organizadores
        || (request.resource.data.get('test', false) == true && request.resource.data.src is string
          && isOrg(request.resource.data.src) && request.resource.data.orgs == tour(request.resource.data.src).get('orgs', [])));
      allow update: if isOrg(tid) && validTour(request.resource.data)
        // la lista de organizadores la cambia solo la administración; un ensayo no deja de serlo
        && (isAdmin() || request.resource.data.orgs == resource.data.orgs)
        && request.resource.data.get('test', false) == resource.data.get('test', false);
      allow delete: if isAdmin() || (isOrg(tid) && resource.data.get('test', false) == true);

      // Inscriptos (público: apodo y avatar). Hace falta usuario (apodo registrado). Cada uno se anota y confirma su presencia;
      // el organizador marca quién aportó al pozo (paid) y puede descalificar (out).
      match /ins/{uid} {
        allow read: if true;
        allow create: if (signedIn() && request.auth.uid == uid
          && tour(tid).st in ['open', 'checkin']
          // visible desde pub; un ensayo, solo para invitados
          && (tour(tid).get('pub', null) == null || request.time >= tour(tid).pub)
          && (!isTest(tid) || uid in tour(tid).get('inv', []))
          && request.resource.data.keys().hasOnly(['nm', 'av', 'at', 'ck', 'paid', 'out'])
          && request.resource.data.nm == get(/databases/$(database)/documents/names/$(uid)).data.name
          && request.resource.data.get('av', '') == get(/databases/$(database)/documents/names/$(uid)).data.get('av', '')
          && request.resource.data.at == request.time
          && request.resource.data.ck == null && request.resource.data.paid == false && request.resource.data.out == false)
          // en un ensayo, el organizador suma jugadores falsos (bot-N) o a sí mismo, ya con check-in
          || (isOrg(tid) && isTest(tid)
            && request.resource.data.keys().hasOnly(['nm', 'av', 'at', 'ck', 'paid', 'out', 'bot'])
            && request.resource.data.nm is string && request.resource.data.nm.size() > 0 && request.resource.data.nm.size() <= 30
            && request.resource.data.at == request.time && request.resource.data.ck == request.time
            && request.resource.data.paid is bool && request.resource.data.out == false);
        // check-in: una sola vez, con la hora del servidor, mientras está abierto
        allow update: if (signedIn() && request.auth.uid == uid && tour(tid).st == 'checkin' && resource.data.ck == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ck'])
            && request.resource.data.ck == request.time)
          || (isOrg(tid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'out'])
            && request.resource.data.paid is bool && request.resource.data.out is bool);
        // borrarse: antes de que arranque
        allow delete: if (signedIn() && request.auth.uid == uid && tour(tid).st in ['open', 'checkin']) || isOrg(tid);
      }
      // Datos de contacto para avisar que arranca la ronda: solo los ven el dueño y los organizadores
      match /priv/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isOrg(tid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['mail', 'tel', 'ok', 'at'])
          && request.resource.data.mail is string && request.resource.data.mail.size() <= 120 && request.resource.data.mail.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
          && request.resource.data.tel is string && request.resource.data.tel.size() >= 6 && request.resource.data.tel.size() <= 30
          // ok: aceptó las bases y condiciones
          && request.resource.data.ok == true
          && request.resource.data.at == request.time;
        allow delete: if (signedIn() && request.auth.uid == uid) || isOrg(tid);
      }

      // Rondas: las crea y maneja el organizador. pl: quienes compiten; adv: cuántos pasan; go/end: arranque y fin (hora del servidor).
      // Palabras o frases que eligió el organizador para cada ronda: solo las ven los organizadores (la partida se genera con ellas)
      match /secret/{x} {
        allow read, write: if isOrg(tid);
      }
      match /rounds/{r} {
        allow read: if true;
        allow write: if isOrg(tid);
        // La partida de la ronda: secreta hasta que arranca (por la hora, o porque el organizador ya la puso en juego)
        match /data/{x} {
          allow read: if isOrg(tid) || get(/databases/$(database)/documents/tourneys/$(tid)/rounds/$(r)).data.st == 'live'
            || (get(/databases/$(database)/documents/tourneys/$(tid)/rounds/$(r)).data.go != null
              && request.time >= get(/databases/$(database)/documents/tourneys/$(tid)/rounds/$(r)).data.go);
          allow write: if isOrg(tid);
        }
        // Resultado y avance de cada jugador. El tiempo lo pone el servidor (at - go). Errores, ayudas, comprobaciones y
        // rondas falladas nunca bajan; una vez terminada (done) no se toca. x: juega sin competir (no está en pl).
        match /res/{uid} {
          allow read: if true;
          allow create, update: if (signedIn() && request.auth.uid == uid && resOk(tid, r, uid))
            // los jugadores falsos de un ensayo los mueve el panel del organizador
            || (uid.matches('^bot-[0-9]+$') && isOrg(tid) && isTest(tid) && resOk(tid, r, uid));
          allow delete: if isOrg(tid);
        }
      }
    }
    function resOk(tid, r, uid) {
      let R = get(/databases/$(database)/documents/tourneys/$(tid)/rounds/$(r)).data;
      let d = request.resource.data;
      let o = resource == null ? {'p': 0, 's': 0, 'e': 0, 'h': 0, 'c': 0, 'f': 0, 'done': false} : resource.data;
      return R.st in ['sched', 'live'] && R.go != null && request.time >= R.go
        && (R.end == null || request.time <= R.end + duration.value(20, 's'))
        && d.keys().hasOnly(['p', 's', 'e', 'h', 'c', 'f', 'ok', 'done', 'at', 'x'])
        && d.keys().hasAll(['p', 's', 'e', 'h', 'c', 'f', 'ok', 'done', 'at', 'x'])
        && d.at == request.time
        && d.p is number && d.p >= 0 && d.p <= 1
        && d.s is int && d.s >= o.s && d.s <= 20
        && d.e is int && d.e >= o.e && d.h is int && d.h >= o.h
        && d.c is int && d.c >= o.c && d.f is int && d.f >= o.f && d.f <= 20
        && d.ok is bool && d.done is bool && (!d.ok || d.done)
        && o.done == false
        && d.x == !(uid in R.pl);
    }
    // Avisos push: cada jugador guarda las suscripciones de sus dispositivos (hasta 5). Las lee la Function (admin SDK).
    function pushSub(s) {
      return s is map && s.keys().hasOnly(['endpoint', 'keys'])
        && s.endpoint is string && s.endpoint.size() <= 1024 && s.endpoint.matches('https://.+')
        && s['keys'] is map && s['keys'].keys().hasOnly(['p256dh', 'auth'])
        && s['keys'].p256dh is string && s['keys'].p256dh.size() <= 200
        && s['keys'].auth is string && s['keys'].auth.size() <= 64;
    }
    function pushSubs(l) {
      return l is list && l.size() <= 5
        && (l.size() < 1 || pushSub(l[0])) && (l.size() < 2 || pushSub(l[1])) && (l.size() < 3 || pushSub(l[2]))
        && (l.size() < 4 || pushSub(l[3])) && (l.size() < 5 || pushSub(l[4]));
    }
    match /pushsubs/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['subs', 'at'])
        && pushSubs(request.resource.data.subs)
        && request.resource.data.at == request.time;
    }

    // Configuración pública que escribe solo la Function (config/push.vapid: clave pública VAPID)
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Claves privadas de la Function: nadie desde la web (el admin SDK no pasa por las reglas)
    match /_private/{id} {
      allow read, write: if false;
    }
  }
}
